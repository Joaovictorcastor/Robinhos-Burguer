<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RobinhosBurguer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\banco\criar.sql" Link="criar.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopiarSite" AfterTargets="Publish">
    <ItemGroup>
      <ArquivosSite Include="..\index.html;..\style.css;..\script.js" />
      <ImagensSite Include="..\img\*.jpg" />
    </ItemGroup>
    <Copy SourceFiles="@(ArquivosSite)" DestinationFolder="$(PublishDir)wwwroot" />
    <Copy SourceFiles="@(ImagensSite)" DestinationFolder="$(PublishDir)wwwroot\img" />
  </Target>
</Project>
